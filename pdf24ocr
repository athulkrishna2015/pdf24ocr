#!/usr/bin/env bash
# pdf24ocr — OCR PDFs via the hidden PDF24 worker API behind tools.pdf24.org/en/ocr-pdf
# Flow (from /static/js/common.js): start session -> upload (multipart) -> action=ocrPdf (JSON)
#      -> action=getStatus poll -> action=getFile
# ponytail: 5s fixed poll, no websocket; swap in getStatus long-poll if a job ever outruns the deadline.
set -euo pipefail

usage() {
	cat <<EOF
Usage: pdf24ocr [options] FILE...

  -l, --lang CODES   language codes joined by '+' for mixed-mode OCR (default: eng, e.g. eng+deu)
  -o, --format FMT   pdf | pdfa (default: pdf)
  -F, --force        OCR even if pages already contain text
  -d, --no-deskew    skip page deskew (on by default)
  -b, --background   detect and remove a noisy background
  -r, --rotate       guess and fix page orientation
  -c, --clean        remove scanning artefacts
  -j, --join         merge all inputs into one PDF (one job, sequential)
  -p, --parallel N   max jobs at once (default 4)
  -O, --out FILE     where to save the PDF; a directory when given several files
      --text FILE    where to save recognized text (single file only)

Several files are OCR'd concurrently, one job each, capped at -p and staggered
by 1s. PDF24 is a free, ad-funded service: keep the default unless you have a
reason, and prefer fewer jobs over more. -j needs the single-job path to merge.

-d is the only preprocessing flag with a clearly measurable effect; -b/-r/-c
are sent and logged server-side but were hard to see a difference from.
Env: PDF24_OCR_LANG, PDF24_OCR_OUT override the -l/-o defaults.
EOF
}

lang=${PDF24_OCR_LANG:-eng}
out=${PDF24_OCR_OUT:-pdf}
force=false
deskew=true
join=false
bgremove=false
rotate=false
clean=false
textout=
dest=
ext= # set from -o below; the fan-out branch may have set it already
par=${PDF24_OCR_PARALLEL:-4}
parpause=${PDF24_OCR_PAUSE:-1}
files=()

while (($#)); do
	case $1 in
		-l | --lang) lang=$2; shift 2 ;;
		-o | --format) out=$2; shift 2 ;;
		-F | --force) force=true; shift ;;
		-d | --no-deskew) deskew=false; shift ;;
		-b | --background) bgremove=true; shift ;;
		-r | --rotate) rotate=true; shift ;;
		-c | --clean) clean=true; shift ;;
		-j | --join) join=true; shift ;;
		--text) textout=$2; shift 2 ;;
		-O | --out) dest=$2; shift 2 ;;
		-p | --parallel) par=$2; shift 2 ;;
		-h | --help) usage; exit 0 ;;
		-*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
		*) files+=("$1"); shift ;;
	esac
done

((${#files[@]})) || { usage >&2; exit 2; }
for f in "${files[@]}"; do [[ -f $f ]] || { echo "not a file: $f" >&2; exit 2; }; done

# writing the output onto an input would destroy the document
if [[ -n $dest ]]; then
	for f in "${files[@]}"; do
		[[ $dest -ef $f ]] && {
			echo "refusing to overwrite input: $f" >&2
			exit 2
		}
	done
fi

# One job per file, run concurrently. Measured on 4 one-page PDFs: 16s this way
# vs 2m38s as a single multi-file job, because the server works a job's files
# one after another. --join still needs the single-job path to merge them.
if ((${#files[@]} > 1)) && ! $join; then
	[[ -n $textout ]] && {
		echo "--text takes one file; use -O DIR with several" >&2
		exit 2
	}
	dir=${dest:-.}
	mkdir -p "$dir"
	ext=$([ "$out" = pdfa ] && echo pdfa || echo pdf)
	args=(-l "$lang" -o "$out")
	$force && args+=(-F)
	$deskew || args+=(-d)
	$bgremove && args+=(-b)
	$rotate && args+=(-r)
	$clean && args+=(-c)
	# re-invoke ourselves per file: one session and one job each, at most
	# $par at a time. This is someone else's free service, so stay a polite
	# client: a handful of parallel jobs, not a flood.
	for f in "${files[@]}"; do
		while (($(jobs -rp | wc -l) >= par)); do sleep 1; done
		base=${f##*/}
		"$0" "${args[@]}" -O "$dir/${base%.*}_ocr.$ext" --text "$dir/${base%.*}_ocr.txt" "${f}" &
		sleep "$parpause" # stagger starts; a burst of N uploads looks automated
	done
	rc=0
	wait || rc=1 # wait returns nonzero if any child failed
	exit $rc
fi

jar=$(mktemp)
trap 'rm -f "$jar"' EXIT

api() { # api <query> [curl args...]
	local q=$1; shift
	curl -fsS -b "$jar" -c "$jar" "$@" "https://$HOST/client.php?$q"
}

# the API answers 4xx with {"errorCode":...,"errorMessage":...} — surface that, not curl's 22
# returns non-zero (rather than exiting) so callers can use it in a pipeline without doubling up
apierr() {
	local q=$1 body
	shift
	body=$(curl -sS -b "$jar" -c "$jar" -w $'\n%{http_code}' "$@" "https://$HOST/client.php?$q") || true
	if [[ $(tail -n1 <<<"$body") != 200 ]]; then
		echo "API error: $(tr -d ' \n' <<<"$body" | head -c 200)" >&2
		return 1
	fi
	sed '$d' <<<"$body"
}

# try each worker host until one reports itself available (page ships 50 of them)
for i in {0..49}; do
	HOST=filetools$i.pdf24.org
	if curl -fsS -m 10 -b "$jar" -c "$jar" -X POST "https://$HOST/client.php?action=start" 2>/dev/null | tr -d ' \n' | grep -q '"available":true'; then
		break
	fi
	[[ $i == 49 ]] && {
		echo "no worker server available" >&2
		exit 1
	}
done

uploads='['
for f in "${files[@]}"; do
	echo "uploading $f..." >&2
	# upload answers with a one-element JSON array; strip the wrapper, we build our own list
	entry=$(apierr action=upload -F "file=@$f") || exit 1
	uploads+=$(tr -d ' \n' <<<"$entry" | sed 's/^\[//;s/\]$//'),
done
uploads=${uploads%,}']'

# server pretty-prints JSON, so squeeze whitespace before matching
job=$(apierr "action=ocrPdf&srcPageId=ocrPdf" \
	-H 'Content-Type: application/json; charset=utf-8' \
	--data-binary "{\"files\":$uploads,\"langCode\":\"$lang\",\"outputType\":\"$out\",\"title\":\"\",\"author\":\"\",\"subject\":\"\",\"keywords\":\"\",\"removeBackground\":$bgremove,\"rotatePages\":$rotate,\"deskew\":$deskew,\"clean\":$clean,\"forceOcr\":$force,\"joinFiles\":$join}") || exit 1
job=$(sed -n 's/.*"jobId":"\([^"]*\)".*/\1/p' <<<"$(tr -d ' \n' <<<"$job")")
[[ -n $job ]] || {
	echo "no jobId returned" >&2
	exit 1
}
echo "job $job" >&2

deadline=$((SECONDS + 3600))
while ((SECONDS < deadline)); do
	sleep 5
	status=$(api action=getStatus --data-urlencode "jobId=$job" | tr -d ' \n')
	case $status in
		*'"status":"done"'*) break ;;
		*'"status":"pending"'*) ;;
		*) echo "job failed: $status" >&2; exit 1 ;;
	esac
done
((SECONDS < deadline)) || {
	echo "timed out" >&2
	exit 1
}

field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" <<<"$2"; }
outfile=$(field out.file "$status")
[[ -n $outfile ]] || {
	echo "no output file in result" >&2
	exit 1
}

[[ $out = pdfa ]] && ext=pdfa
ext=${ext:-pdf}
dest=${dest:-${files[0]%.*}_ocr.$ext}
textout=${textout:-${files[0]%.*}_ocr.txt}

api "action=getFile&jobId=$job&file=$outfile" -o "$dest"
echo "$dest"

txt=$(field 0.text.out.file "$status")
if [[ -n $txt ]]; then
	api "action=getFile&jobId=$job&file=$txt" -o "$textout" && echo "$textout"
fi